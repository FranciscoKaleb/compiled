# Copy to .env and edit. Every value is optional; these are the defaults.

# Random string used to sign the session cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Where model weights, tool output and the database live. Gitignored.
# DATA_DIR=/absolute/path/to/app_files

# SQLite needs no setup. To use MySQL instead, start the service and point here:
#   DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost/compiled
# DATABASE_URL=sqlite:///app_files/db/app.db

# Uploads larger than this are rejected with a 413.
MAX_UPLOAD_MB=500

# Cosine-similarity cut-offs for face matching (0-1).
FACE_MATCH_THRESHOLD=0.65
FACE_COMPARE_THRESHOLD=0.4

# How long a tool keeps its output files before purging them.
TOOL_JOB_TTL_HOURS=24

# Werkzeug debugger and reloader. Never enable where others can reach the app.
FLASK_DEBUG=0

# Bind address for `python run.py`.
# HOST=127.0.0.1
# PORT=5000
